# Copy to .env and fill in. All values are PUBLIC (client-side) — no secrets here.
# Analytics is optional: with no key set, events log to the console in dev and are
# silent in prod. Never call posthog.identify() — kid-safe anonymous events only.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Cloud backup (Wave C). BOTH are public by design — a Firebase web apiKey
# identifies a project, it authorises nothing; security is Firestore rules plus
# anonymous auth. They are NOT required: src/sdk/cloudConfig.ts carries the real
# values as committed defaults, precisely so a missing repo secret cannot
# silently kill the feature the way an absent VITE_POSTHOG_KEY killed analytics.
# Set these only to point a fork or a staging build at a different project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
