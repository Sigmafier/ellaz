{
  "name": "ellaz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ellaz — a cross-device games platform. Play on phone, tablet, and PC.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:check": "npm run build && node scripts/assert-first-visit.mjs && node scripts/assert-payload.mjs && node scripts/assert-pages.mjs && node scripts/assert-slope.mjs",
    "assert:first-visit": "node scripts/assert-first-visit.mjs",
    "assert:payload": "node scripts/assert-payload.mjs",
    "assert:slope": "node scripts/assert-slope.mjs",
    "assert:pages": "node scripts/assert-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:cloud": "node scripts/probe-cloud.mjs",
    "assert:crawlable": "node scripts/assert-crawlable.mjs",
    "assert:live": "node scripts/assert-live.mjs",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "assert:standalone": "node scripts/assert-standalone.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "posthog-js": "^1.160.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "bidi-js": "^1.0.3",
    "jsdom": "^25.0.1",
    "satori": "^0.29.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2"
  }
}
