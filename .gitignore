node_modules
dist
dist-ssr
# EVERY build arm, not a list of the ones somebody remembered.
#
# Almost nothing in this repo is measured with one build: the payload gate wants
# two arms of one tree, the slope gate builds two more, and half the failures
# here are base-dependent so both bases get their own. Each of those is a
# `dist-<something>` nobody will ever commit - and naming them one at a time
# left 25 of them sitting in `git status`, which is exactly the noise that makes
# a `git add -A` dangerous in a repo three lanes work at once.
#
# `dist-ellaz` and `dist-standalone*` below are subsumed and kept anyway: they
# are the two with a REASON, and the reason is worth more than the line.
dist-*
# second-base build arm, produced by scripts/check-both-bases.sh
dist-ellaz
dist-standalone
# the zips handed to itch/Newgrounds. NOT inside dist-standalone/ - the gate
# scans every child of that directory as a bundle, so a zips/ folder parked
# there reports as a fourth, torn bundle (0 html, 0 js) and fails the run.
dist-standalone-zips
*.local
.env
.env.local
.DS_Store
.firebase
firebase-debug.log
dev-dist
shots/

# Browser-automation scratch (MCP session dumps, ad-hoc screenshots)
.playwright-mcp/
/*.png
screenshots/

# Generated by `npm run reach:backlinks -- --html` from backlinks.md.
# Never committed: a checked-in copy is a second source of truth that goes
# stale the moment a link dies, which is the one thing the file exists to catch.
docs/outreach/backlinks.html

# The reach board's published artifact, built by `npm run reach:site` and by
# .github/workflows/deploy-reach.yml. Never committed: it is a RENDERING of
# docs/outreach/backlinks.md, and a checked-in copy is a second source of truth
# that goes stale the moment a link dies - the one thing the board exists to catch.
dist-reach/
